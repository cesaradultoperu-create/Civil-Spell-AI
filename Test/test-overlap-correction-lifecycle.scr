1
Si
Salir
_.U
(correction-assert (equal before (correction-snapshot)) "UNDO_EXACT")
RESTAURARSOLAPES
REVISARPOLILINEAS
Corregir
Seleccion
!reviewset

0.000001
1
Si
Salir
(correction-assert (null (entget source)) "REAPPLY_AFTER_UNDO")
RESTAURARSOLAPES
(correction-assert (equal before (correction-snapshot)) "FINAL_RESTORE")
(setq duplicate-keeper (correction-poly '((50 0) (60 0)) 0) duplicate (correction-poly '((60 0) (50 0)) 0) reviewset (ssadd duplicate (ssadd duplicate-keeper)) before (correction-snapshot))
REVISARPOLILINEAS
Corregir
Seleccion
!reviewset

0.000001
1
Si
Salir
(correction-assert (and (entget duplicate-keeper) (null (entget duplicate)) (= (length (correction-snapshot)) (1- (length before)))) "FULL_DUPLICATE")
RESTAURARSOLAPES
(correction-assert (equal before (correction-snapshot)) "FULL_DUPLICATE_RESTORE")
(princ "\nCORRECTION_LIFECYCLE_DONE\n")
_.QUIT
_Y
