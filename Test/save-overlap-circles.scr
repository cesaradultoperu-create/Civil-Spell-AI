(defun source-snapshot (/ ss i data) (setq ss (ssget "_X" '((410 . "Model") (0 . "LWPOLYLINE"))) i 0 data nil) (repeat (sslength ss) (setq data (cons (entget (ssname ss i)) data) i (1+ i))) data)
(progn (setq original-snapshot (source-snapshot)) (princ))
