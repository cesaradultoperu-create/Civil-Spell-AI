      <Private>false</Private><EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Reference Include="Autodesk.AutoCAD.Interop.Common">
      <HintPath>$(AutoCADPath)\Autodesk.AutoCAD.Interop.Common.dll</HintPath>
      <Private>false</Private><EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
    <Compile Include="ExcelPlanSync.cs" /><Compile Include="DrawingRenumber.cs" /><Compile Include="RenumberWorkbook.cs" /><Compile Include="SheetSetSync.cs" /><Compile Include="JsonCodec.cs" /><Compile Include="PackagePaths.cs" /><Compile Include="TitleParts.cs" /><Compile Include="TitleBlockBinding.cs" /><Compile Include="TitleBlockSync.cs" /><Compile Include="SheetSetDisplay.cs" /><Compile Include="WorkbookData.cs" /><Compile Include="NewDrawingSync.cs" /><Compile Include="DrawingSaveAudit.cs" /><Compile Include="DrawingRetirement.cs" /><Compile Include="TitleBlockAudit.cs" />
