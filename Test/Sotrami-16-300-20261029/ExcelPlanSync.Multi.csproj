<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <CadFamily Condition="'$(CadFamily)' == ''">2023-2024</CadFamily>
    <TargetFramework Condition="'$(CadFamily)' == '2023-2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(CadFamily)' == '2025'">net8.0-windows</TargetFramework>
    <DefineConstants Condition="'$(CadFamily)' == '2025'">$(DefineConstants);CAD2025</DefineConstants>
    <AssemblyName>VinculoPlanosSOTRAMI.v33.$(CadFamily)</AssemblyName>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\..\</RepoRoot>
    <RestorePackagesPath>$(RepoRoot).packages</RestorePackagesPath>
    <OutputPath>$(RepoRoot)Test\Actualizacion-Planos-SOTRAMI-20261016\</OutputPath>
    <AutoCADPath Condition="'$(AutoCADPath)' == ''">$(ProgramW6432)\Autodesk\AutoCAD 2024</AutoCADPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(CadFamily)' == '2023-2024'">
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="AutoCAD.NET" Version="24.2.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(CadFamily)' == '2025'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DrawingExcelAlert.cs" />
