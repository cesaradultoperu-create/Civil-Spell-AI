(progn (setq source-set (ssget "_X" '((410 . "Model") (0 . "LWPOLYLINE")))) (setq chosen (ssname source-set 1) reviewset (ssadd chosen)) (princ))
(defun outside-snapshot (/ i data en)
  (setq i 0 data nil)
  (repeat (sslength source-set)
    (setq en (ssname source-set i))
    (if (not (equal (cdr (assoc 5 (entget en))) (cdr (assoc 5 (entget chosen)))))
      (setq data (cons (entget en) data)))
    (setq i (1+ i)))
  data)
(progn (setq outside-before (outside-snapshot) chosen-before (entget chosen)) (princ))
