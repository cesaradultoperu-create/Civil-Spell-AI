(corte-assert (equal corte-after (entget corte-target)) "TARGET_IDEMPOTENT")
RESTAURARPOLILINEAS
AISPELLTESTRESTORED
(corte-assert (equal corte-original (entget corte-target)) "TARGET_RESTORED_EXACT")
(corte-assert (vl-every '(lambda (item) (equal (cdr item) (entget (car item)))) corte-others) "CIVIL_LINE_3D_STILL_UNCHANGED")
(princ "\nCORTE_TINY_CLEANUP_DONE\n")
_.QUIT
_Y
