        "**/obj/**": true,
        "**/.work/**": true,
        "**/outputs/**": true,
        "**/node_modules/**": true,
        "**/Test/**": true
    },
    "search.exclude": {
        "**/Test/**/profile*/**": true,
        "**/Test/**/perfil*/**": true,
        "**/Test/**/pydeps/**": true,
        "**/artifacts/**": true,
        "**/.packages/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/.work/**": true,
        "**/outputs/**": true,
        "**/node_modules/**": true,
        "**/Test/**": true
    }
}
