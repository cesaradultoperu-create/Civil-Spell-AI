<Window x:Class="CivilSpellAI.UI.BatchPreparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CivilSpellAI · Analizando dibujo"
        Width="470"
        Height="210"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=CancelAnalysisButton}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   FontSize="19"
                   FontWeight="SemiBold"
                   Text="Preparando revisión global" />
        <TextBlock Grid.Row="1"
                   Margin="0,7,0,14"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Text="Todavía no se está escribiendo ningún objeto del dibujo." />
        <ProgressBar Grid.Row="2"
                     Height="20"
                     Minimum="0"
                     Maximum="{Binding TotalCount}"
                     AutomationProperties.Name="Progreso de revisión del dibujo"
                     AutomationProperties.HelpText="Cantidad de textos analizados durante la preparación; todavía no se modifica el dibujo."
                     Value="{Binding CompletedCount}" />
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="CancelAnalysisButton"
                    DockPanel.Dock="Right"
                    MinWidth="100"
                    Padding="12,7"
                    IsEnabled="{Binding CanCancel}"
                    Click="CancelClick"
                    Content="_Cancelar" />
            <TextBlock VerticalAlignment="Center"
                       AutomationProperties.Name="Estado de preparación de la revisión"
                       AutomationProperties.LiveSetting="Polite"
                       Text="{Binding StatusText}" />
        </DockPanel>
    </Grid>
</Window>
