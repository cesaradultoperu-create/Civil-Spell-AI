<Window x:Class="CivilSpellAI.UI.SpellReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CivilSpellAI · Revisar texto"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=AlternativesList}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Revisar corrección" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="El dibujo no cambiará hasta que elija una alternativa y pulse Aplicar." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontWeight="SemiBold" Text="Texto original" />
            <TextBlock Grid.Column="1">
                <Run Text="Idioma: " />
                <Run FontWeight="SemiBold" Text="{Binding LanguageDisplay}" />
            </TextBlock>
        </Grid>

        <TextBox Grid.Row="2"
                 MinHeight="72"
                 Margin="0,0,0,14"
                 Padding="8"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Texto original"
                 Text="{Binding OriginalText, Mode=OneWay}" />

        <GroupBox Grid.Row="3" Header="Alternativas" Margin="0,0,0,14">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="3,0,3,5">
                    <Button x:Name="RetryButton"
                            DockPanel.Dock="Right"
                            MinWidth="80"
                            Padding="7,3"
                            IsEnabled="{Binding CanRetry}"
                            Click="RetryClick"
                            Content="_Reintentar" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               AutomationProperties.Name="Estado del proveedor de corrección"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding ProviderStatusDisplay}" />
                </DockPanel>
                <ListBox x:Name="AlternativesList"
                         Grid.Row="1"
                         MinHeight="150"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Alternativas de corrección"
                         ItemsSource="{Binding Proposals}"
                         SelectedItem="{Binding SelectedProposal, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           Text="{Binding Explanation}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,0,0,6">
            <CheckBox DockPanel.Dock="Right"
                      IsChecked="{Binding IsManualEditEnabled, Mode=TwoWay}"
                      AutomationProperties.Name="Editar el resultado manualmente"
                      Content="_Editar resultado manualmente" />
            <TextBlock FontWeight="SemiBold" Text="Resultado propuesto" />
        </DockPanel>

        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     MinHeight="72"
                     Padding="8"
                     IsReadOnly="{Binding IsResultReadOnly}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Resultado propuesto o edición manual"
                     Text="{Binding ResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <GroupBox Grid.Row="1" Header="Cambios calculados localmente" Margin="0,10,0,0">
                <TextBlock Margin="8"
                           FontFamily="Consolas"
                           AutomationProperties.Name="Cambios calculados localmente"
                           Text="{Binding CurrentDiffText}" />
            </GroupBox>

            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="8"
                    Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1">
                <TextBlock Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                           AutomationProperties.Name="Resultado de la validación técnica"
                           AutomationProperties.LiveSetting="Polite"
                           Text="{Binding CurrentValidationText}" />
            </Border>
        </Grid>

        <DockPanel Grid.Row="6" Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Margin="0"
                    Click="KeepOriginalClick"
                    Content="_Mantener original" />
            <CheckBox DockPanel.Dock="Left"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding CanApply}"
                      IsChecked="{Binding RememberPreference, Mode=TwoWay}"
                      Content="_Recordar esta decisión localmente" />
            <Button DockPanel.Dock="Right"
                    IsDefault="True"
                    IsEnabled="{Binding CanApply}"
                    Click="ApplyClick"
                    Content="_Aplicar" />
            <Button DockPanel.Dock="Right"
                    IsCancel="True"
                    Click="CancelClick"
                    Content="_Cancelar" />
        </DockPanel>
    </Grid>
</Window>
