<Window x:Class="CivilSpellAI.UI.TransitionSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CivilSpellAI.UI"
        Title="Sección paramétrica"
        Width="980"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="23" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap"
                       Text="Las medidas se expresan en unidades del dibujo. Los espesores se mantienen uniformes en ambos lados." />
            <DockPanel Margin="0,10,0,0" LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,14,0"
                           FontWeight="SemiBold"
                           Text="Nueva sección con valores manuales, o use una figura existente:" />
                <Button Width="205"
                        Height="27"
                        Click="CreateFromObjectClick"
                        Content="Crear sección desde objeto..."
                        AutomationProperties.Name="Crear sección desde objeto" />
                <ComboBox x:Name="SectionTypeComboBox"
                          Width="1"
                          Visibility="Collapsed"
                          SelectionChanged="SectionTypeSelectionChanged"
                          AutomationProperties.Name="Modelo de sección">
                    <ComboBoxItem Tag="A" Content="Tipo A · Transición horizontal" />
                    <ComboBoxItem Tag="B" Content="Tipo B · Ampliación doble" />
                </ComboBox>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="105" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="L1" /><Run Text=" · Longitud recta inicial (sin cota en la imagen):" /></TextBlock>
                <TextBox x:Name="InitialStraightTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Longitud recta inicial" />
                <TextBlock Grid.Row="1" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="L2" /><Run Text=" · Longitud de transición:" /></TextBlock>
                <TextBox x:Name="TransitionLengthTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Longitud de transición" />
                <TextBlock x:Name="FinalStraightLabel" Grid.Row="2" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="L3" /><Run x:Name="FinalStraightLabelText" Text=" · Longitud recta final:" /></TextBlock>
                <TextBox x:Name="FinalStraightTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Longitud recta final" />
                <TextBlock Grid.Row="3" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="H1" /><Run Text=" · Altura libre inicial:" /></TextBlock>
                <TextBox x:Name="InitialClearHeightTextBox" Grid.Row="3" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Altura libre inicial" />
                <TextBlock Grid.Row="4" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="H2" /><Run x:Name="FinalHeightLabelText" Text=" · Altura libre final:" /></TextBlock>
                <TextBox x:Name="FinalClearHeightTextBox" Grid.Row="4" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Altura libre final" />
                <TextBlock Grid.Row="5" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="α" /><Run Text=" · Inclinación del muro (grados):" /></TextBlock>
                <TextBox x:Name="InnerThicknessTextBox" Grid.Row="5" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Inclinación del muro en grados" />
                <TextBlock Grid.Row="6" Margin="0,5,10,5"><Run Foreground="#D71920" FontWeight="Bold" Text="E2" /><Run Text=" · Espesor del muro:" /></TextBlock>
                <TextBox x:Name="OuterThicknessTextBox" Grid.Row="6" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Espesor del muro" />
                <TextBlock Grid.Row="7" Margin="0,5,10,5" Text="Altura de muros 3D:" />
                <TextBox x:Name="WallHeightTextBox" Grid.Row="7" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Altura de muros 3D" />
                <TextBlock Grid.Row="8" Margin="0,5,10,5" Text="Patrón de hatch:" />
                <ComboBox x:Name="HatchPatternComboBox"
                          Grid.Row="8"
                          Grid.Column="1"
                          Margin="0,3"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          SelectionChanged="HatchSelectionChanged"
                          AutomationProperties.Name="Patrón de hatch">
                    <ComboBoxItem Content="GRAVEL" />
                    <ComboBoxItem Content="AR-CONC" />
                    <ComboBoxItem Content="ANSI31" />
                    <ComboBoxItem Content="ANSI32" />
                    <ComboBoxItem Content="ANSI37" />
                    <ComboBoxItem Content="BRICK" />
                    <ComboBoxItem Content="DOTS" />
                    <ComboBoxItem Content="EARTH" />
                    <ComboBoxItem Content="SAND" />
                    <ComboBoxItem Content="SOLID" />
                </ComboBox>
                <TextBlock Grid.Row="9" Margin="0,5,10,5" Text="Escala del hatch:" />
                <TextBox x:Name="HatchScaleTextBox" Grid.Row="9" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Escala del hatch" />
                <TextBlock Grid.Row="10" Margin="0,5,10,5" Text="Ángulo del hatch (grados):" />
                <TextBox x:Name="HatchAngleTextBox" Grid.Row="10" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Ángulo del hatch" />
                <TextBlock Grid.Row="11" Margin="0,5,10,5" Text="Color del hatch (ACI 0–256):" />
                <TextBox x:Name="HatchColorTextBox" Grid.Row="11" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" AutomationProperties.Name="Color ACI del hatch" />
                <TextBlock x:Name="SecondTransitionLabel" Grid.Row="12" Margin="0,5,10,5" Visibility="Collapsed"><Run Foreground="#D71920" FontWeight="Bold" Text="L4" /><Run Text=" · Segunda transición:" /></TextBlock>
                <TextBox x:Name="SecondTransitionTextBox" Grid.Row="12" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" Visibility="Collapsed" AutomationProperties.Name="Segunda longitud de transición" />
                <TextBlock x:Name="TerminalHeightLabel" Grid.Row="13" Margin="0,5,10,5" Visibility="Collapsed"><Run Foreground="#D71920" FontWeight="Bold" Text="H3" /><Run Text=" · Altura total terminal:" /></TextBlock>
                <TextBox x:Name="TerminalHeightTextBox" Grid.Row="13" Grid.Column="1" Margin="0,3" TextChanged="ValueTextChanged" Visibility="Collapsed" AutomationProperties.Name="Altura total terminal" />
            </Grid>

            <Border Grid.Column="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="White">
                <local:TransitionSectionPreview x:Name="SectionPreview"
                                                Height="340"
                                                AutomationProperties.Name="Vista previa de la sección paramétrica" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,14"
                Padding="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StackPanel>
                <TextBlock x:Name="InitialTotalTextBlock" />
                <TextBlock x:Name="FinalTotalTextBlock" Margin="0,4,0,0" />
                <TextBlock x:Name="DimensionedLengthTextBlock" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" IsDefault="True" Click="AcceptClick" Content="_Aceptar" />
            <Button Width="90" IsCancel="True" Content="_Cancelar" />
        </StackPanel>
    </Grid>
</Window>
