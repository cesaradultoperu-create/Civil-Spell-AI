<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DrenBordes.2024</AssemblyName>
    <Version>0.1.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <RestorePackagesPath>../../.packages</RestorePackagesPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IncludeNativeTests)' == 'true'">
    <DefineConstants>$(DefineConstants);DREN_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <Reference Include="accoremgd"><HintPath>$(ProgramW6432)/Autodesk/AutoCAD 2024/accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(ProgramW6432)/Autodesk/AutoCAD 2024/acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(ProgramW6432)/Autodesk/AutoCAD 2024/acmgd.dll</HintPath><Private>false</Private></Reference>
    <Compile Remove="NativeTests.cs" />
    <Compile Include="NativeTests.cs" Condition="'$(IncludeNativeTests)' == 'true'" />
  </ItemGroup>
</Project>
