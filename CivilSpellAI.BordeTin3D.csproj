<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>CivilSpellAI.BordeTin3D.v013</AssemblyName>
    <Version>0.1.3</Version>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\BordeTin3D\$(Configuration)\2024\</OutputPath>
    <Deterministic>true</Deterministic>
    <RestorePackagesPath>$(MSBuildProjectDirectory)\.packages</RestorePackagesPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="accoremgd"><HintPath>$(AutoCAD2024Path)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AutoCAD2024Path)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AutoCAD2024Path)\acmgd.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="Geometry\TinBoundaryGeometry.cs" />
    <Compile Include="Geometry\TinBoundaryUnion.cs" />
    <Compile Include="Geometry\TinBoundaryDependencies.cs" />
    <Compile Include="Autodesk\TinBoundaryDrawingService.cs" />
    <Compile Include="Commands\TinBoundaryCommands.cs" />
    <Compile Include="Tests\TinBoundaryNativeCommands.cs" Condition="'$(IncludeNativeTests)' == 'true'" />
    <Compile Include="Tests\TinBoundarySessionProbe.cs" Condition="'$(IncludeSessionProbe)' == 'true'" />
  </ItemGroup>
</Project>
