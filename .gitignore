# Local workspaces and downloaded dependencies (authored Test sources have an allowlist)
/.work/
/outputs/
/Presentaciones/
/Drawing1.dwg
/acad.err
node_modules/
python-libs/
pydeps/
__pycache__/
*.pyc
*.pyo
