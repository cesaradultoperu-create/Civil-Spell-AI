.cache/

# Credentials stay on each computer
.env
.env.*
!.env.example
*.pfx
*.p12

# Local Lisp examples: keep the authored programs, leave drawings/images/data on disk
/Lisp/**
!/Lisp/**/
!/Lisp/**/*.lsp
!/Lisp/**/*.md
